# Runtime
ENVIRONMENT=local
DEPLOYMENT_PROFILE=local
RETRIEVAL_PROVIDER=local
GENERATION_PROVIDER=ollama
RERANKER_PROVIDER=local

# Ollama and generation
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:7b
GENERATION_TIMEOUT_SECONDS=120
GENERATION_CONCURRENCY_LIMIT=1

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Pin this to a Hugging Face commit when rebuilding production indexes.
EMBEDDING_MODEL_REVISION=
# CPU is the stable default; opt into CUDA/MPS only after load testing.
EMBEDDING_DEVICE=cpu
# Keep Torch and FAISS native pools bounded; one is sufficient for single-query search.
EMBEDDING_NATIVE_THREADS=1

# Retrieval
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
DEFAULT_TOP_K=10
SEARCH_CANDIDATE_POOL=50
SEARCH_TIMEOUT_SECONDS=30

# Reranking remains off until a leakage-free validation benchmark shows a gain.
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=false
RERANKER_TIMEOUT_SECONDS=30

# Corpus and indexes
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EMBEDDINGS_DIR=data/embeddings

# API and browser client
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_REQUEST_TIMEOUT_SECONDS=60
API_CONCURRENCY_LIMIT=4

# RAG grounding
RAG_ENABLED=true
RAG_MIN_RELEVANCE_SCORE=0.2
RAG_MAX_CONTEXT_CHARS=24000

# Cloud retrieval (set only for DEPLOYMENT_PROFILE=cloud)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=academic-papers-current
# Select an exact model ID marked Cost: Free in the cluster Inference tab.
QDRANT_DENSE_MODEL=
# all-MiniLM-L6-v2 uses 384; set the dimension explicitly for any other model.
QDRANT_DENSE_VECTOR_SIZE=384
QDRANT_SPARSE_MODEL=qdrant/bm25
QDRANT_TIMEOUT_SECONDS=15
QDRANT_EXPECTED_CORPUS_SHA256=
QDRANT_EXPECTED_SCHEMA_VERSION=1
ALLOW_DEGRADED_RETRIEVAL=false

# Cloud generation
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_OUTPUT_TOKENS=1024

# Required by the production cloud API; copy only this token to Streamlit Secrets.
BACKEND_API_TOKEN=
HEALTH_CACHE_SECONDS=10
SEARCH_RATE_LIMIT_PER_MINUTE=60
ASK_RATE_LIMIT_PER_MINUTE=10
# Semantic evidence verification (optional; use fail-closed in production pilots)
SEMANTIC_VERIFICATION_ENABLED=false
VERIFICATION_PROVIDER=disabled
VERIFICATION_MODEL_NAME=
VERIFICATION_TIMEOUT_SECONDS=30
VERIFICATION_FAIL_CLOSED=false
MAX_RAG_REPAIR_ATTEMPTS=1
